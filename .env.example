# ============================================
# HUNTING QUERY DASHBOARD - ENVIRONMENT CONFIG
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# DATABASE CONFIGURATION
# ============================================
# MySQL Connection String
# Format: mysql://username:password@host:port/database
# Examples:
#   Local: mysql://root:password@localhost:3306/hunting_queries
#   Remote: mysql://user:pass@db.example.com:3306/hunting_queries
#   TiDB: mysql://root:password@tidb-server:4000/hunting_queries
DATABASE_URL="mysql://root:password@localhost:3306/hunting_queries"

# ============================================
# OPENAI API CONFIGURATION
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
# This is required for AI query generation and conversion features
OPENAI_API_KEY="sk-your-api-key-here"

# ============================================
# SERVER CONFIGURATION
# ============================================
# Node environment (development, production, test)
NODE_ENV="development"

# Server port
PORT=3000

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# Secret key for JWT token signing
# Generate a strong random string: openssl rand -base64 32
JWT_SECRET="your-secret-key-change-this-in-production"

# Session duration in milliseconds (default: 24 hours)
SESSION_DURATION=86400000

# ============================================
# OPTIONAL: ADVANCED CONFIGURATION
# ============================================

# Database connection pool size
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# API rate limiting (requests per minute)
# RATE_LIMIT=100

# CORS allowed origins (comma-separated)
# CORS_ORIGINS="http://localhost:3000,https://example.com"

# Log level (debug, info, warn, error)
# LOG_LEVEL="info"

# ============================================
# NOTES
# ============================================
# 1. Never commit .env file to version control
# 2. Use strong, unique values for secrets
# 3. Change default admin password after first login
# 4. Keep API keys secure and rotate regularly
# 5. In production, use environment variables instead of .env file
